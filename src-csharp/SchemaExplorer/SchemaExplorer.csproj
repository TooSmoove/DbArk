<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SchemaExplorer.Tests" />
    <InternalsVisibleTo Include="SchemaExplorer.IntegrationTests" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/EngineNames.cs" Link="EngineNames.cs" />
    <Compile Include="../Shared/NativeString.cs" Link="NativeString.cs" />
    <Compile Include="../Shared/SqliteConnectionString.cs" Link="SqliteConnectionString.cs" />
    <Compile Include="../Shared/SqlIdentifier.cs" Link="SqlIdentifier.cs" />
  </ItemGroup>
</Project>
