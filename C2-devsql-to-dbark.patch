+          # legacy "devsql:" / "~/.devsql" names. Remove --exclude=main.rs
+          # below once that shim is deleted post-v1.0.
+          matches=$(grep -rInI \
+            --exclude-dir=node_modules --exclude-dir=target \
+            --exclude-dir=obj --exclude-dir=bin \
+            --exclude-dir=.git --exclude-dir=.vs \
+            --exclude=main.rs \
+            -e devsql \
+            src src-tauri src-csharp index.html package.json || true)
+          if [ -n "$matches" ]; then
+            echo "::error::Stale 'devsql' naming found in shipped source — finish the DbArk rename:"
+            echo "$matches"
+            exit 1
+          fi
+          echo "OK: no stale devsql naming in shipped source (migration shim in main.rs excepted)."
+
