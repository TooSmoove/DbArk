+    }
+
+    #[test]
+    fn kv_quotes_equals_and_trailing_whitespace() {
+        assert_eq!(escape_kv_value("base64=="), "\"base64==\"");
+        assert_eq!(escape_kv_value("trailing "), "\"trailing \"");
+        assert_eq!(escape_kv_value(" leading"), "\" leading\"");
+    }
+
+    #[test]
