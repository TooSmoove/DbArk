{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "DbArk default capability set — minimal permissions only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-clear"
  ]
}